# ============================================================================
# FILM AGENT — AI Short Film Studio Environment Template (.env.example)
# Copy this file to .env and fill in your API keys
# ============================================================================

# --- Project & Server Settings ---
PROJECT_NAME="FILM AGENT — Qwen-Image-2.1 & FLUX.1 AI Studio"
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# --- AI Scene Director / LLM Settings ---
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3-flash-preview"

# --- Hugging Face Token (Optional, for gated model downloads) ---
HF_TOKEN="your_huggingface_token_here"

# --- Local GPU Image & Video Generation Settings ---
FLUX_MODEL_VARIANT="Qwen-Image-2.1 (Local GPU High-Precision)"
COMFYUI_URL="http://127.0.0.1:8188"
QWEN_DEFAULT_STEPS=16
FLUX_SCHNELL_DEFAULT_STEPS=4
FLUX_DEV_DEFAULT_STEPS=20
LORA_TRIGGER_MALE="arjun_male"
LORA_TRIGGER_FEMALE="maya_female"
